    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 25
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 80
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "In the midst of a war-torn Scotland, where mist curled over the hills
    like secretive ghosts, you stand beside William Wallace. [whispers] He trusts
    you\u2026 yes, you, Gijs, with his very life. [smirks] Don\u2019t let it go to
    your head.\n\nThe enemy eyes flicker like restless fire across the valley. Your
    mission? Distract them. [playfully] And no, running around screaming won\u2019t
    do\u2014think graceful chaos, the distraction dance of legends.\n\n[softly] Watch
    the dots. Follow them. Every step you take, every movement you make, helps Gijs
    lead the enemy away, giving William the edge he needs. [encouraging] Keep focused\u2026
    and maybe, just maybe, you\u2019ll live to tell the tale."
